import streamlit as st
import pandas as pd
from Bio import SeqIO
from Bio.SeqUtils import gc_fraction
import plotly.express as px

# --- PAGE CONFIGURATION ---
st.set_page_config(
    page_title="Genome Annotation Parser",
    page_icon="🧬",
    layout="wide"
)

st.title("🧬 Genome Annotation Parser")
st.markdown("Upload a **GenBank (`.gb`, `.gbk`)** file to extract annotations, compute genome statistics, and visualize feature locations.")

# --- SIDEBAR: FILE UPLOAD & FILTERS ---
st.sidebar.header("1. Upload Genome File")
uploaded_file = st.sidebar.file_uploader("Choose a GenBank file", type=["gb", "gbk"])

# --- CORE PARSING FUNCTION ---
@st.cache_data
def parse_genbank(file_contents):
    """Parses uploaded GenBank file string using Biopython."""
    # Convert uploaded bytes into text string for Biopython
    from io import StringIO
    stringio = StringIO(file_contents.decode("utf-8"))
    record = SeqIO.read(stringio, "genbank")
    
    # Extract genome-level metadata
    sequence_length = len(record.seq)
    gc_content = gc_fraction(record.seq) * 100
    
    # Extract feature-level metadata
    features_data = []
    for feat in record.features:
        # Get gene name and product if available
        gene = feat.qualifiers.get("gene", ["N/A"])[0]
        product = feat.qualifiers.get("product", ["N/A"])[0]
        locus_tag = feat.qualifiers.get("locus_tag", ["N/A"])[0]
        
        features_data.append({
            "Type": feat.type,
            "Start": int(feat.location.start),
            "End": int(feat.location.end),
            "Length (bp)": int(feat.location.end - feat.location.start),
            "Strand": "+" if feat.location.strand == 1 else ("-" if feat.location.strand == -1 else "Unknown"),
            "Gene": gene,
            "Locus Tag": locus_tag,
            "Product": product
        })
        
    df_features = pd.DataFrame(features_data)
    return record, sequence_length, gc_content, df_features

# --- MAIN APP LOGIC ---
if uploaded_file is not None:
    try:
        file_bytes = uploaded_file.read()
        record, seq_len, gc_val, df_features = parse_genbank(file_bytes)
        
        # --- METRICS DASHBOARD ---
        st.header("1. Genome Overview")
        col1, col2, col3, col4 = st.columns(4)
        col1.metric("Accession ID", record.id)
        col2.metric("Genome Size", f"{seq_len:,} bp")
        col3.metric("GC Content", f"{gc_val:.2f}%")
        col4.metric("Total Features", f"{len(df_features):,}")
        
        st.caption(f"**Organism:** {record.annotations.get('organism', 'Unknown')}")
        
        st.divider()

        # --- SIDEBAR FILTERS ---
        st.sidebar.header("2. Filter Features")
        available_types = df_features["Type"].unique().tolist()
        selected_types = st.sidebar.multiselect(
            "Select Feature Types:",
            options=available_types,
            default=[t for t in ["gene", "CDS", "tRNA"] if t in available_types]
        )
        
        search_query = st.sidebar.text_input("Search (Gene, Locus Tag, or Product):")

        # Apply filters
        filtered_df = df_features[df_features["Type"].isin(selected_types)]
        
        if search_query:
            query = search_query.lower()
            filtered_df = filtered_df[
                filtered_df["Gene"].str.lower().str.contains(query) |
                filtered_df["Locus Tag"].str.lower().str.contains(query) |
                filtered_df["Product"].str.lower().str.contains(query)
            ]

        # --- VISUALIZATION ---
        st.header("2. Interactive Feature Map")
        if not filtered_df.empty:
            # Create a horizontal range chart using Plotly
            fig = px.timeline(
                filtered_df,
                x_start="Start",
                x_end="End",
                y="Type",
                color="Type",
                hover_data=["Gene", "Locus Tag", "Product", "Length (bp)", "Strand"],
                title="Genomic Coordinates of Filtered Features"
            )
            fig.update_yaxes(autorange="reversed")  # Standardize top-down view
            fig.update_layout(xaxis_title="Genomic Position (bp)", height=400)
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.warning("No features match the selected filters.")

        st.divider()

        # --- DATA TABLE & EXPORT ---
        st.header("3. Extracted Annotation Table")
        st.write(f"Showing **{len(filtered_df)}** of **{len(df_features)}** parsed features:")
        
        st.dataframe(filtered_df, use_container_width=True)
        
        # Download button for parsed CSV
        csv_data = filtered_df.to_csv(index=False).encode('utf-8')
        st.download_button(
            label="📥 Download Filtered Annotations as CSV",
            data=csv_data,
            file_name=f"{record.id}_annotations.csv",
            mime="text/csv"
        )

    except Exception as e:
        st.error(f"Error parsing file: {e}")
        st.info("Please ensure you uploaded a valid GenBank (.gb / .gbk) format file.")

else:
    st.info("👆 Please upload a `.gbk` or `.gb` file in the sidebar to begin parsing.")
    st.markdown("""
    ### Don't have a GenBank file?
    You can download sample bacterial or viral GenBank files directly from NCBI:
    * Search for an organism (e.g., *Escherichia coli* or *Sars-CoV-2*) on [NCBI Nucleotide](https://www.ncbi.nlm.nih.gov/nucleotide/).
    * Click **Send to** -> **File** -> **Format: GenBank (full)** -> **Create File**.
    """)
